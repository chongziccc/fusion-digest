{"canonical_id": "doi:10.1109/tmm.2026.3746723", "aliases": [], "merged_from": null, "title": "DDFusion: Modality-Specific Degradation Decoupling for Robust Infrared-Visible Image Fusion", "authors": ["IEEE TMM Author Group"], "arxiv_id": "", "arxiv_version": "", "doi": "10.1109/tmm.2026.3746723", "published_at": "2026-10-20", "updated_at": "2026-10-20", "window_date": "2026-10-20", "first_seen": "2026-11-06", "last_checked": "2026-11-06", "run_date": "2026-11-06", "source_urls": ["https://doi.org/10.1109/tmm.2026.3746723"], "abstract": "Decouples modality-specific degradation factors (optical blur, sensor noise, low contrast) before fusion, guaranteeing degradation-robust cross-modal representation.", "category": "core_ivif", "event_type": "screened", "lifecycle_status": "unread", "reading_status": "unread", "fulltext_status": "partial", "score": 9, "score_detail": {"relevance": 3, "innovation": 2, "transfer": 2, "venue": 1, "verifiability": 1, "code": 0}, "score_version": "v5.4", "publication_status": "Published", "publication_status_evidence": "official", "venue": "IEEE Transactions on Multimedia (TMM)", "venue_year": "2026", "venue_track": "Regular Journal", "venue_tier": "A 类 / 1 区 TOP", "venue_tier_source": "venue_tiers.md（CCF 第七版 2026 / 中科院 2025 年最终版）", "alert_level": "medium", "publication_status_source": "Crossref / IEEE Xplore Official", "publication_status_checked_at": "2026-11-06", "event_id": "doi:10.1109/tmm.2026.3746723#2026-11-06T09:45:00Z#screened"}
