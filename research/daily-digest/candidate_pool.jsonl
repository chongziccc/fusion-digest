{"canonical_id": "arxiv:2609.38968", "aliases": [], "merged_from": null, "title": "Beyond Spatial-Domain Supervision: A Relation Constrained Space for Multi-Modal Image Fusion", "authors": ["Long Shen", "Zhe Wang", "Chunxia Zhao"], "arxiv_id": "2609.38968", "arxiv_version": "v2", "doi": "", "published_at": "2026-09-30", "updated_at": "2026-10-15", "window_date": "2026-10-15", "first_seen": "2026-11-07", "last_checked": "2026-11-07", "run_date": "2026-11-07", "source_urls": ["https://arxiv.org/abs/2609.38968"], "abstract": "Constrains cross-modal feature relations in a relational latent space beyond standard spatial losses.", "category": "core_ivif", "event_type": "screened", "lifecycle_status": "unread", "reading_status": "unread", "fulltext_status": "available", "score": 8, "score_detail": {"relevance": 3, "innovation": 2, "transfer": 2, "venue": 0, "verifiability": 1, "code": 0}, "score_version": "v5.4", "publication_status": "Preprint", "publication_status_evidence": "official", "venue": "arXiv cs.CV", "venue_year": "2026", "venue_track": "Preprint", "venue_tier": "待人工核实", "venue_tier_source": "venue_tiers.md", "alert_level": "none", "publication_status_source": "arXiv official metadata", "publication_status_checked_at": "2026-11-07", "event_id": "arxiv:2609.38968#2026-11-07T04:00:00Z#screened"}
{"canonical_id": "arxiv:2607.23600", "aliases": ["conf:acmmm2026:confusion"], "merged_from": null, "title": "ConFusion: Continuous Fusion Space Learning for Fine-Grained Controllable Infrared and Visible Image Fusion", "authors": ["Yurong Guo", "Yufei He", "Yonghao Li", "Dongliang Chang", "Ke Zhang", "Zhanyu Ma"], "arxiv_id": "2607.23600", "arxiv_version": "v1", "doi": "", "published_at": "2026-07-28", "updated_at": "2026-07-28", "window_date": "2026-07-28", "first_seen": "2026-11-08", "last_checked": "2026-11-08", "run_date": "2026-11-08", "source_urls": ["https://arxiv.org/abs/2607.23600", "https://arxiv.org/pdf/2607.23600", "https://github.com/HeyufeiAnto/Confusion"], "abstract": "Controllable infrared–visible image fusion aims to integrate complementary thermal and structural information with flexible region-aware modulation, producing fused images that adapt to diverse user requirements and downstream tasks. However, existing methods typically rely on predefined discrete control conditions, leading to a sparse space that fails to support fine-grained modulation demands. To address this, we propose ConFusion, a novel framework that learns the continuous fusion space via Gaussian-conditioned spatial-aware modulation, enabling instance-level fine-grained controllable infrared and visible image fusion. ConFusion employs a dual-branch architecture to disentangle modality-invariant and modality-specific representations under joint reconstruction and text-guided semantic alignment. Gaussian-conditioned instance modulation variables coupled with Grounded SAM-based instance masks guide instance-level fine-grained modulation through the Mask-Guided Specific Feature Modulator, while the Text-Driven Invariant Feature Enhancer improves semantic consistency and enhances fusion. During inference, the multimodal large language model parses user intents into instance-level modulation variables to guide image fusion. Extensive experiments show that ConFusion achieves state-of-the-art performance across multiple metrics in both fusion quality and downstream tasks, while supporting fine-grained controllable image fusion.", "category": "core_ivif", "event_type": "read", "lifecycle_status": "read", "reading_status": "read", "fulltext_status": "available", "score": 11, "score_detail": {"relevance": 3, "innovation": 3, "transfer": 2, "venue": 1, "verifiability": 1, "code": 1}, "score_version": "v5.4", "publication_status": "Accepted", "publication_status_evidence": "official", "venue": "ACM MM", "venue_year": "2026", "venue_track": "Main Track", "venue_tier": "A 类", "venue_tier_source": "venue_tiers.md（CCF 第七版 2026）", "alert_level": "high", "publication_status_source": "ACM MM 2026 Official Acceptance / arXiv metadata / GitHub repo", "publication_status_checked_at": "2026-11-08", "event_id": "arxiv:2607.23600#2026-11-08T03:45:00Z#read"}
{"event_id": "arxiv:2606.15104#2026-11-09T03:45:00Z#screened", "canonical_id": "arxiv:2606.15104", "aliases": [], "merged_from": null, "title": "Text-Driven Fusion for Infrared and Visible Images: Achieving Image Scene Adaptation on Hyperbolic Space", "authors": ["Huan Kang", "Hui Li", "Tianyang Xu", "Tao Zhou", "Xiao-Jun Wu", "Josef Kittler"], "arxiv_id": "2606.15104", "arxiv_version": "v1", "doi": "", "published_at": "2026-06-13", "updated_at": "2026-06-13", "window_date": "2026-06-13", "first_seen": "2026-11-09", "last_checked": "2026-11-09", "run_date": "2026-11-09", "source_urls": ["https://arxiv.org/abs/2606.15104", "https://arxiv.org/pdf/2606.15104"], "abstract": "Infrared and visible image fusion aims to integrate complementary modalities, while existing Euclidean methods impose rigid distance metrics that distort multi-modal interactions and parent-to-child semantic hierarchies. To overcome these limitations, we introduce TEDFusion, a text-driven fusion framework empowered by Hyperbolic Space (Poincaré ball) with negative curvature.", "category": "core_ivif", "event_type": "screened", "lifecycle_status": "unread", "reading_status": "unread", "fulltext_status": "available", "score": 11, "score_detail": {"relevance": 3, "innovation": 4, "transfer": 2, "venue": 0, "verifiability": 1, "code": 1}, "score_version": "v5.4", "publication_status": "Preprint", "publication_status_evidence": "none", "venue": "arXiv cs.CV", "venue_year": "2026", "venue_track": "Preprint", "venue_tier": "待人工核实", "venue_tier_source": "venue_tiers.md（CCF 第七版 / 中科院 2025 年版）", "alert_level": "high", "publication_status_source": "arXiv cs.CV Official Metadata", "publication_status_checked_at": "2026-11-09"}
