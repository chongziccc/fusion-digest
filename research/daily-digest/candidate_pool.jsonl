{"canonical_id": "arxiv:2610.23663", "aliases": ["conf:neurips2026:pcdfusion"], "merged_from": null, "title": "PCDFusion: Proposal-Context-Detail Bayesian Rendering for Infrared-Visible Image Fusion", "authors": ["Rui Liu", "Lin Gu", "Hesong Li", "Ying Fu"], "arxiv_id": "2610.23663", "arxiv_version": "v1", "doi": "", "published_at": "2026-10-16", "updated_at": "2026-10-16", "window_date": "2026-10-16", "first_seen": "2026-11-06", "last_checked": "2026-11-06", "run_date": "2026-11-06", "source_urls": ["https://arxiv.org/abs/2610.23663", "https://arxiv.org/pdf/2610.23663"], "abstract": "Infrared-visible image fusion (IVIF) aims to combine visible and thermal infrared observations into a unified image representation for human perception and downstream computer vision tasks. Visible and thermal infrared observations are physically complementary but unreliable in different ways. Existing deep IVIF methods mainly improve feature interaction and reconstruction, but often lack an explicit local rule for deciding when visible appearance should dominate and when thermal responses should contribute. To address this issue, we reformulate IVIF as local Bayesian posterior rendering, where fusion is decomposed into Proposal, Context, and Detail stages.", "category": "core_ivif", "event_type": "read", "lifecycle_status": "read", "reading_status": "read", "fulltext_status": "available", "score": 10, "score_detail": {"relevance": 3, "innovation": 3, "transfer": 2, "venue": 1, "verifiability": 1, "code": 0}, "score_version": "v5.4", "publication_status": "Accepted", "publication_status_evidence": "official", "venue": "NeurIPS", "venue_year": "2026", "venue_track": "Main Track", "venue_tier": "A 类", "venue_tier_source": "venue_tiers.md（CCF 第七版 2026）", "alert_level": "high", "publication_status_source": "NeurIPS 2026 Official Acceptance / arXiv Comment", "publication_status_checked_at": "2026-11-06", "event_id": "arxiv:2610.23663#2026-11-06T09:45:00Z#read"}
{"canonical_id": "arxiv:2611.01607", "aliases": [], "merged_from": null, "title": "NatureFusion: Rethinking Infrared and Visible Image Fusion as Natural Complementary Enhancement", "authors": ["Jianfeng Ding", "Linfeng Tang", "Hao Zhang", "Han Xu", "Xunpeng Yi", "Yibing Zhang", "Meiqi Gong", "Zhongyuan Wang", "Jiayi Ma"], "arxiv_id": "2611.01607", "arxiv_version": "v1", "doi": "", "published_at": "2026-11-01", "updated_at": "2026-11-01", "window_date": "2026-11-01", "first_seen": "2026-11-06", "last_checked": "2026-11-07", "run_date": "2026-11-07", "source_urls": ["https://arxiv.org/abs/2611.01607", "https://arxiv.org/pdf/2611.01607"], "abstract": "In the absence of ground truth, most existing infrared and visible image fusion methods pursue fidelity to the source images and directly superimpose two physically distinct modalities. As a result, salient infrared targets appear as bright patches of thermal radiation pasted onto the scene. These patches obscure the original color and texture of the targets, so the fused images look unnatural to human observers and deviate from the data distribution learned by vision models pretrained on visible images. Therefore, we redefine infrared and visible image fusion as natural complementary enhancement rather than source fidelity, and propose NatureFusion...", "category": "core_ivif", "event_type": "read", "lifecycle_status": "read", "reading_status": "read", "fulltext_status": "available", "score": 9, "score_detail": {"relevance": 3, "innovation": 3, "transfer": 2, "venue": 0, "verifiability": 1, "code": 0}, "score_version": "v5.4", "publication_status": "Preprint", "publication_status_evidence": "official", "venue": "arXiv cs.CV", "venue_year": "2026", "venue_track": "Preprint", "venue_tier": "待人工核实", "venue_tier_source": "venue_tiers.md", "alert_level": "high", "publication_status_source": "arXiv official metadata", "publication_status_checked_at": "2026-11-06", "event_id": "arxiv:2611.01607#2026-11-07T04:00:00Z#read"}
